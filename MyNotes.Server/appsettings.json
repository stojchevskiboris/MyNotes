{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "devDb": "Server=(localdb)\\mssqllocaldb;Database=MyNotesDb;Trusted_Connection=True;"
  },
  "AppSettings": {
    "AesSecretKey": "dummy_aes_secret_key_32_characters_long",
    "GoogleAuth": {
      "ClientId": "dummy_client_id",
      "ClientSecret": "dummy_client_secret",
      "ProjectId": "dummy_project_id",
      "AuthUri": "https://accounts.google.com/o/oauth2/auth",
      "TokenUri": "https://oauth2.googleapis.com/token",
      "AuthProviderCertUrl": "https://www.googleapis.com/oauth2/v1/certs",
      "Issuer": "https://accounts.google.com"
    },
    "LocalAuth": {
      "Secret": "dummy_local_auth_secret_at_least_32_chars",
      "Issuer": "MyNotesServer",
      "Audience": "MyNotesClient",
      "ExpireMinutes": 60
    }
  }
}
